# Public URL of the landing page; used for canonical, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.com

# Migios backoffice URL; "Masuk" and "Coba Gratis" link to /sign-in and /sign-up on it.
# Leave empty to make those buttons scroll to the CTA section instead.
NEXT_PUBLIC_APP_URL=

# Contact channels on /kontak. While both are empty (dummy stage) the WhatsApp/email links scroll to
# the form and the form only shows an on-page confirmation; once set they open WhatsApp or email.
# WhatsApp number in international format, digits only (country code first).
NEXT_PUBLIC_CONTACT_WHATSAPP=
NEXT_PUBLIC_CONTACT_EMAIL=

# Migios backend origin without /api/v1, read on the server only. Prices, capacities, features,
# add-ons and the trial length come from GET /api/v1/public/pricing (cached ~10 minutes). Leave
# empty to use src/content/pricing.json; refresh that file with `npm run pricing:snapshot`.
MIGIOS_API_URL=
